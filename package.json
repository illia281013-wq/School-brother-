{
  "name": "ai-school-assistant",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node -e \"process.env.NODE_ENV='production'; import('./server/index.js')\"",
    "test": "node --test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "vite": "^6.1.0",
    "@playwright/test": "^1.56.1"
  }
}
